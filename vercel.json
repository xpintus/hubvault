{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/tools/cash-calculator",
      "destination": "/cash-calculator.html"
    },
    {
      "source": "/tools/cod-reconciliation-calculator",
      "destination": "/cod-reconciliation-calculator.html"
    },
    {
      "source": "/collection-reconciliation-software",
      "destination": "/hubvault-software.html"
    },
    {
      "source": "/cod-reconciliation-software",
      "destination": "/cod-reconciliation.html"
    },
    {
      "source": "/daily-closing-software",
      "destination": "/daily-closing-software.html"
    },
    {
      "source": "/logistics-cash-collection-software",
      "destination": "/logistics-cash-collection-software.html"
    }
  ]
}
